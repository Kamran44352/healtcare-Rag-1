# OpenAI
OPENAI_API_KEY=sk-...

# LlamaParse
LLAMA_CLOUD_API_KEY=llx-...

# Firecrawl (website crawling — single page scrape)
FIRECRAWL_API_KEY=fc-...
FIRECRAWL_API_URL=https://api.firecrawl.dev
FIRECRAWL_TIMEOUT_SECONDS=120

# Qdrant Cloud
QDRANT_URL=https://xxx.cloud.qdrant.io
QDRANT_API_KEY=...
QDRANT_COLLECTION=healthcare_chunks
QDRANT_REQUEST_TIMEOUT_SECONDS=30
QDRANT_RETRIEVAL_TIMEOUT_SECONDS=20

# Supabase
SUPABASE_URL=https://akgwjwiqoptexxrgmbpk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...
SUPABASE_STORAGE_BUCKET=documents
STORE_PDF_IN_BUCKET=true

# Redis
# Upstash requires TLS — use rediss:// (not redis://) on port 6379.
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=clintel
# Connection resilience. REDIS_SOCKET_TIMEOUT_SECONDS must stay GREATER than
# CRAWL_STREAM_BLOCK_MS/1000, or every blocking stream read trips the client
# deadline. HEALTH_CHECK_INTERVAL matters on Upstash, which reaps idle
# connections server-side.
REDIS_SOCKET_TIMEOUT_SECONDS=30
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=10
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
REDIS_MAX_CONNECTIONS=16
REDIS_RETRY_ATTEMPTS=3
REDIS_DISABLED_COOLDOWN_SECONDS=60

# Bulk crawl stream
CRAWL_STREAM_BLOCK_MS=15000
CRAWL_STREAM_ERROR_BACKOFF_BASE_SECONDS=1
CRAWL_STREAM_ERROR_BACKOFF_MAX_SECONDS=60
# Also caps how many crawl items process concurrently (one dispatcher reads the
# stream; this bounds the worker pool behind it).
URL_INGESTION_CONCURRENCY=8

# Observability (LangSmith). Tracing is off unless BOTH the flag and a key are set.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=clintel
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LOG_LEVEL=INFO

# App
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000
INGESTION_CONCURRENCY=3

# Scheduled auto re-scrape (web sources only)
RESCRAPE_ENABLED=true
RESCRAPE_CHECK_INTERVAL_SECONDS=900
RESCRAPE_DEFAULT_INTERVAL_HOURS=24
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Models
# foreground_model = the "important", low-volume calls: per-document metadata
#   extraction (ingestion Stage D) and the final answer-generation call (both
#   the LangGraph agent's generate_answer node and the legacy non-agent path).
# background_model = the cheap, high-volume, per-chunk/per-turn calls: chunk
#   enrichment, contextual prefixes, intent classification, filter extraction,
#   query rewriting, chunk grading, and grounding verification.
FOREGROUND_MODEL=gpt-5.4-mini
BACKGROUND_MODEL=gpt-4.1-mini
# Changing EMBEDDING_MODEL or EMBEDDING_DIMENSIONS after go-live requires
# reindexing every document — the Qdrant collection's vector size is fixed at
# creation time and old vectors aren't compatible with a new embedding space.
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

# Agent (Phase 3) — set AGENT_ENABLED=false to fall back to Phase 2 one-shot RAG
AGENT_ENABLED=true
AGENT_COVERAGE_THRESHOLD=0.6
AGENT_MAX_RETRIES=1
AGENT_GROUNDING_THRESHOLD=0.5
# Only refuse a question as out-of-scope when the classifier is at least this
# confident. Below it, the question falls through to retrieval and the evidence
# decides — a wrong refusal never reaches the corpus at all, so failing open is
# much cheaper than failing closed.
AGENT_OUT_OF_SCOPE_CONFIDENCE=0.9

# ── Per-step model overrides ────────────────────────────────────────────────
# Each falls back to BACKGROUND_MODEL when blank. Benchmarked 2026-09-06 against
# this repo's real prompts (see the numbers below) — measure before switching,
# the intuitive choice was not the fastest.
#
# CLASSIFY / REWRITE  (median per question, intent accuracy on 8 cases):
#   gpt-4.1-nano   828ms   7/8   fastest, but misclassified one question
#   gpt-5.4-mini   933ms   8/8
#   gpt-4.1-mini   967ms   8/8   <- current default
#   gpt-4o-mini   1203ms   8/8   SLOWER than the current default
#   gpt-5.4-nano  1230ms   8/8
#
# GROUNDING  (median over clean + planted-error answers, 4 reps each):
#   gpt-5.4-mini  1349ms   correct on both   <- 2.4x faster than gpt-4.1-mini
#   gpt-4o-mini   2450ms   correct on both   most consistent verdicts
#   gpt-5.4-nano  3249ms   correct but always escalates to "fail"
#   gpt-4.1-mini  3279ms   correct on both
CLASSIFY_MODEL=
REWRITE_MODEL=
GRADING_MODEL=
# 2.4x faster than gpt-4.1-mini with identical pass/flag correctness. This step
# runs AFTER the answer is generated, so its latency is pure dead time for the user.
GROUNDING_MODEL=gpt-5.4-mini
